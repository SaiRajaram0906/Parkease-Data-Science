DATABASE_URL="postgresql://postgres:root@localhost:5432/postgres"
PORT=5000

# ---- Booking emails ("parking started" / "parking ended") ----
# Remove the # from the two lines below and fill them in to send real emails.
# With Gmail: SMTP_USER is your Gmail address and SMTP_PASS is a Google
# "app password" (Google Account > Security > 2-Step Verification > App
# passwords), not your normal password. Then restart the API server.
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-letter-app-password
# For another mail provider also set: SMTP_HOST=  SMTP_PORT=  MAIL_FROM=
